# --- Pool de Proveedores IA Gratuitos ---
# Google AI Studio (Gemini 2.5 Flash) - https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Nvidia NIM API (Llama 3.3 70B - 40 RPM) - https://build.nvidia.com/
NVIDIA_NIM_API_KEY=your_nvidia_nim_key_here

# Groq Cloud (ultra-rapida) - https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Open Router (modelos gratuitos) - https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- HF Space (Opcional) ---
HF_SPACE_URL="https://huggingface.co/spaces/your-hf-username/your-hf-space-name"
HF_TOKEN="hf_YOUR_TOKEN"
HF_MAX_TOKENS="2048"
HF_TEMPERATURE="0.7"
HF_TOP_P="0.9"
HF_TIMEOUT="60"

# --- Legacy / Proxy ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free
OPENROUTER_TIMEOUT=30

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TIMEOUT=30

LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=gemma-2-2b-it
LM_STUDIO_TIMEOUT=60

PROXY_API_KEY=
PROXY_BASE_URL=https://api.cerebras.ai/v1
PROXY_MODEL=glm-4
PROXY_TIMEOUT=30

# --- Preferencia de proveedor ---
AI_PROVIDER_PREFERENCE=auto
