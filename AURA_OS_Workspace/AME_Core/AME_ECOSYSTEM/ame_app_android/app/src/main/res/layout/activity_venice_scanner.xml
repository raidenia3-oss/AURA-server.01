<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔍 VENICE SCANNER — External Recon"
        android:textColor="#FF6B6B"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Placeholder listo para integración con Venice"
        android:textColor="#8B949E"
        android:textSize="11sp"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- IP Target Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="IP OBJETIVO:"
        android:textColor="#58A6FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etTargetIp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#161B22"
        android:textColor="#00FF41"
        android:textColorHint="#484F58"
        android:hint="ej: 192.168.1.1"
        android:text="8.8.8.8"
        android:paddingHorizontal="12dp"
        android:textSize="14sp"
        android:singleLine="true"
        android:layout_marginBottom="8dp" />

    <!-- Scan Type Spinner -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TIPO DE ESCANEO:"
        android:textColor="#58A6FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerScanType"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#161B22"
        android:layout_marginBottom="8dp" />

    <!-- Threads -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="THREADS:"
            android:textColor="#58A6FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center_vertical" />

        <EditText
            android:id="@+id/etThreads"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="#161B22"
            android:textColor="#00FF41"
            android:text="1"
            android:inputType="number"
            android:paddingHorizontal="8dp"
            android:textSize="14sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Start Button -->
    <Button
        android:id="@+id/btnStartScan"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="⚡ INICIAR ESCANEO"
        android:textColor="#FFFFFF"
        android:backgroundTint="#DA3633"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressScan"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#00FF41"
        android:background="#161B22"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvScanProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Listo para escanear"
        android:textColor="#8B949E"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Console Output -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📟 CONSOLA DE RESULTADOS:"
        android:textColor="#58A6FF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <ScrollView
        android:id="@+id/scrollConsole"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#010409"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF41"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="[ AURA Scanner Terminal ]\nEsperando comandos...\n" />
    </ScrollView>

    <!-- TODO: VENICE_IMPLEMENTATION -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚠️ Motor mock activo — Pendiente integración Venice"
        android:textColor="#D29922"
        android:textSize="10sp"
        android:gravity="center"
        android:paddingTop="4dp" />

</LinearLayout>
