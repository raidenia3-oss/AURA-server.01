            "url": "/api/radar",
            "icons": [
                {
                    "src": "/static/images/aura-icon-192x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Task Queue",
            "short_name": "Tasks",
            "description": "Cola de tareas de automatizacion",
            "url": "/api/tasks",
            "icons": [
                {
                    "src": "/static/images/aura-icon-192x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
