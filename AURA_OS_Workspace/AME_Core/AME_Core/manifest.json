    "description": "Dashboard tactico para gestion de inteligencia y automatizacion en tiempo real",
    "start_url": "https://aura-server-01.vercel.app/",
    "scope": "https://aura-server-01.vercel.app/",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "orientation": "any",
    "background_color": "#1a1a2e",
