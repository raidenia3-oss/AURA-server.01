# AURA/AME - .gitignore
# Archivos generados por Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg
.egg-info/
env/
venv/
ENV/
env.bak/
venv.bak/

# Configuración local
.env
.env.local
.env.backup
.env.template
aura_urls.json
aura_status.json
health_check_results.json

# Bases de datos
*.db
*.sqlite
*.sqlite3
*.db-journal

# Cloudflare
.cloudflared/
cloudflared/config.yml

# Godot
godot_game/.godot/
godot_game/project.godot.lock
godot_game/import/

# Android/Termux
ame_config.json
.gradle/
app/build/
.venv*/
env*/
venv_decision_core/
*.apk
*.jar
*.so
*.dex
*.obb
*.zip
*.7z
*.rar
*.tar.gz

# Archivos de sistema
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*.bak
*.tmp
*.log
*.old
*.tmp
*.crash
*.dmp

# Archivos de compilación
dist/
build/
node_modules/
output/
*.min.js
*.min.css
*.map

# Archivos de IDE
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# Incluir directorios vacíos (para mantener estructura)
!godot_game/assets/.gitkeep
!godot_game/scenes/.gitkeep
!godot_game/autoloads/.gitkeep
!godot_game/scripts/.gitkeep
