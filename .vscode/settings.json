{
  "files.exclude": {
    "**/env": true,
    "**/venv": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/*.pyd": true
  },
  "search.exclude": {
    "**/env": true,
    "**/venv": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  "files.watcherExclude": {
    "**/env/**": true,
    "**/venv/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true
  },
  "python.analysis.exclude": [
    "**/env/**",
    "**/venv/**",
    "**/.venv/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**"
  ],
  "python.analysis.autoSearchPaths": true,
  "python.analysis.extraPaths": [
    "./AURA_Core",
    "./AME_Core"
  ]
}
