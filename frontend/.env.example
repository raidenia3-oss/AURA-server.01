# ======================
# NEXT.JS & DEPLOYMENT
# ======================
NEXT_PUBLIC_SITE_URL=https://aura-web-chi-seven.vercel.app
NEXT_PUBLIC_API_URL=https://aura-web-chi-seven.vercel.app

# Backend (FastAPI en Render) — los route handlers de app/api/* lo usan como proxy.
# En Vercel se define ESTA variable en el Dashboard (Environment Variables → Production).
NEXT_PUBLIC_BACKEND_URL=https://aura-backend-qwhl.onrender.com

# ======================
# SECURITY & AUTHENTICATION (requeridas en producción)
# ======================
# Bearer secret para /api/webhooks y /api/logs.
# Si NO está seteado, esos endpoints quedan abiertos (modo dev).
API_SECRET_KEY=your_api_secret_key_here

# ======================
# INTEGRACIONES (opcionales — cada una enciende su status)
# ======================
SLACK_CLIENT_ID=xoxb-your-token
SLACK_REDIRECT_URI=https://aura-web-chi-seven.vercel.app/api/slack/install
SLACK_SIGNING_SECRET=your-signing-secret
DISCORD_TOKEN=your-discord-bot-token
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefgh
TEAMS_APP_ID=your-teams-app-id

# ======================
# MONITORING 24/7 (scripts/monitor-24-7.js)
# ======================
LOG_LEVEL=info

# ======================
# PHASE 58 (React Native / Fine-tuning / Analytics) — requiere Cline + entorno
# ======================
# Firebase (Auth + Realtime)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aura-ame-ecosystem
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PRIVATE_KEY_ID=your_key_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@aura-ame-ecosystem.iam.gserviceaccount.com

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_secret

# HuggingFace (fine-tuning)
HF_TOKEN=hf_your_hugging_face_token
HF_REPO_ID=raidenia3-oss/ame-finetuned
HF_MODEL_ID=Qwen/Qwen2.5-Coder-3B

# ElevenLabs (TTS)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id

# Database / Analytics engine
DATABASE_URL=postgresql://user:password@host:5432/aura_analytics
REDIS_URL=redis://localhost:6379

# Scheduled jobs
EASYCRON_TOKEN=your-easycron-token
CRON_SECRET=your-cron-secret

# Fine-tuning params
TRAINING_DATA_PATH=./training-data.jsonl
MODEL_OUTPUT_PATH=./fine-tuned-model
TRAINING_EPOCHS=3
BATCH_SIZE=4
LEARNING_RATE=2e-5

# Analytics engine
ANOMALY_DETECTION_THRESHOLD=2.5
ML_PREDICTION_DAYS=7

# ======================
# BACKEND API (Render)
# ======================
NEXT_PUBLIC_BACKEND_URL=https://aura-backend-qwhl.onrender.com
