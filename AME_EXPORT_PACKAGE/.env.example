# ══════════════════════════════════════════════════════════════════════════════
# AME_EXPORT_PACKAGE — Variables de Entorno
# 1. Copiar este archivo como .env
# 2. Pegar tu API Key gratuita de OpenRouter (https://openrouter.ai/keys)
# 3. Listo — el servidor usará OpenRouter para el proxy sin censura
# ══════════════════════════════════════════════════════════════════════════════

# 🔑 API Key de OpenRouter (100% GRATIS — obtener en https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 🧠 Modelo por defecto
OPENROUTER_MODEL=openai/gpt-4o-mini

# 🌐 Host del servidor (0.0.0.0 para aceptar conexiones del móvil)
PROXY_HOST=0.0.0.0

# 🚪 Puerto del servidor
PROXY_PORT=8000

# 📂 Ruta de la bóveda de conocimiento (relativa al server.py)
VAULT_PATH=AURA_INTELLIGENCE_VAULT

# 📡 URL del servidor de telemetría de la PC central (opcional)
AURA_PC_URL=ws://192.168.1.100:8765

# ⏱️ Intervalo de telemetría en segundos
TELEMETRY_INTERVAL=30

# 🆔 ID de este nodo
NODE_ID=ame-pc-node-01