{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://aura-backend.up.railway.app/api/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "https://aura-backend.up.railway.app"
  }
}